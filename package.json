{
  "name": "najwer23morsels",
  "version": "1.10.4",
  "exports": {
    "./lib/*": {
      "types": "./lib/*/index.d.ts",
      "import": "./lib/*/index.js"
    }
  },
  "author": "Mariusz Najwer (https://najwer23.github.io/)",
  "homepage": "https://najwer23.github.io/najwer23morsels",
  "type": "module",
  "scripts": {
    "deploy": "yarn build-storybook && gh-pages -d storybook-static && rimraf ./storybook-static",
    "start": "storybook dev -p 6006",
    "build": "rimraf ./lib && rollup -c --silent",
    "build-storybook": "storybook build",
    "publish:patch": "yarn build && npm version patch --force && npm publish && rimraf ./lib && rimraf ./.yarn/cache",
    "publish:minor": "yarn build && npm version minor --force && npm publish && rimraf ./lib && rimraf ./.yarn/cache",
    "publish:major": "yarn build && npm version major --force && npm publish && rimraf ./lib && rimraf ./.yarn/cache",
    "god": "yarn publish:patch",
    "plop": "plop && yarn format && yarn start",
    "format": "biome check --write",
    "release": "yarn build && yarn && changeset && changeset version && changeset publish && rimraf ./lib && rimraf ./.yarn/cache"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@changesets/cli": "^3.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "1.0.2",
    "@storybook/addon-a11y": "^10.6.5",
    "@storybook/addon-docs": "^10.6.5",
    "@storybook/react-vite": "^10.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "gh-pages": "^6.3.0",
    "plop": "^4.0.5",
    "postcss": "^8.5.32",
    "react": "^19.3.1",
    "react-docgen-typescript": "^2.4.0",
    "react-dom": "^19.3.1",
    "rimraf": "^6.1.3",
    "rollup": "^4.65.1",
    "rollup-plugin-output-size": "^2.0.0",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "rollup-plugin-postcss": "^4.0.2",
    "rollup-plugin-typescript2": "0.37.0",
    "storybook": "^10.6.5",
    "storybook-css-modules-preset": "^1.1.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.5"
  },
  "peerDependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "keywords": [
    "react",
    "react 19",
    "storybook",
    "storybook 10",
    "design-system",
    "gh-pages",
    "typescript",
    "rollup",
    "tree shaking",
    "vite",
    "css modules",
    "front-end"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/najwer23/najwer23morsels.git"
  },
  "license": "MIT"
}
